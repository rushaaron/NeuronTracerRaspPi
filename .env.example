# Copy to .env and adjust. Every value here is optional -- the defaults work as-is.

# --- Cloudflare tunnel ---
# Host directory holding cert.pem and <tunnel-id>.json for the neurontracer tunnel.
# Kept separate from any other tunnel's credentials on this Pi (see README.md).
CLOUDFLARED_DIR=/home/rushpi/.cloudflared-neurontracer

# --- Tracer limits ---
# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=25
# Largest image accepted, in megapixels.
MAX_IMAGE_MEGAPIXELS=40
# Traces allowed to run at the same time. Keep this low on a Pi.
TRACE_CONCURRENCY=2
# Seconds a single trace may run before it is abandoned.
TRACE_TIMEOUT_SECONDS=300
# Seconds a finished result stays in memory for the browser to collect.
RESULT_RETENTION_SECONDS=600
